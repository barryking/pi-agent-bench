{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/barryking/pi-agent-bench/configs/schemas/agent-profiles.schema.json",
  "title": "Pi Agent Bench agent profiles",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "profiles"],
  "properties": {
    "$schema": {"type": "string"},
    "version": {"const": 1},
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z0-9][a-z0-9._-]*$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "description",
          "pi_profile",
          "model_resources",
          "default_model_resource"
        ],
        "properties": {
          "description": {"type": "string", "minLength": 1},
          "pi_profile": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
          "model_resources": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"}
          },
          "default_model_resource": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          }
        }
      }
    }
  }
}
