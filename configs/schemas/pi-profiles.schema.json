{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/barryking/pi-agent-bench/configs/schemas/pi-profiles.schema.json",
  "title": "Pi Agent Bench Pi profiles",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "profiles"],
  "properties": {
    "$schema": {"type": "string"},
    "version": {"const": 1},
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z0-9][a-z0-9._-]*$"},
      "additionalProperties": {"$ref": "#/$defs/profile"}
    }
  },
  "$defs": {
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "path": {"type": "string", "minLength": 1}
      }
    },
    "mcpServer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "extension", "transport", "server", "tools"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "extension": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "transport": {"enum": ["stdio", "http", "sse"]},
        "server": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "tools": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          }
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "tools",
        "runtime_env",
        "settings",
        "context_files",
        "system_prompt",
        "append_system_prompts",
        "skills",
        "extensions",
        "prompt_templates",
        "mcp_servers"
      ],
      "properties": {
        "description": {"type": "string", "minLength": 1},
        "tools": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "runtime_env": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        },
        "settings": {"type": "object"},
        "context_files": {"type": "array", "items": {"$ref": "#/$defs/resource"}},
        "system_prompt": {
          "anyOf": [{"type": "null"}, {"$ref": "#/$defs/resource"}]
        },
        "append_system_prompts": {
          "type": "array",
          "items": {"$ref": "#/$defs/resource"}
        },
        "skills": {"type": "array", "items": {"$ref": "#/$defs/resource"}},
        "extensions": {"type": "array", "items": {"$ref": "#/$defs/resource"}},
        "prompt_templates": {
          "type": "array",
          "items": {"$ref": "#/$defs/resource"}
        },
        "mcp_servers": {"type": "array", "items": {"$ref": "#/$defs/mcpServer"}}
      }
    }
  }
}
