# Copy to .env.local. This file is ignored by git.
#
# Local or self-hosted OpenAI-compatible endpoint. Include /v1.
# A DGX Spark vLLM server is one supported example.
LOCAL_MODEL_BASE_URL=http://local-model-host:8000/v1
# vLLM may be configured without authentication; Inspect's OpenAI adapter still
# expects a non-empty value, so use a dummy value only on a trusted private LAN.
LOCAL_MODEL_API_KEY=replace-me

# Hosted controls. The example profile maps these to OPENAI_API_KEY only for
# the duration of that evaluation.
HOSTED_QUALITY_API_KEY=replace-me
HOSTED_COST_API_KEY=replace-me

# Optional: path only, never the OAuth contents. Required by a pi_direct
# subscription profile after completing Pi's interactive /login flow.
PI_AUTH_FILE=/Users/replace-me/.pi/agent/auth.json
