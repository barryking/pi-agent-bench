{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/barryking/pi-agent-bench/evals/schemas/outcome-case.schema.json",
  "title": "Pi Agent Bench Outcome Case",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "instruction", "limits", "expected", "metadata"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "instruction": {
      "type": "string",
      "minLength": 1
    },
    "tags": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seconds", "turns", "context_tokens"],
      "properties": {
        "seconds": {"type": "integer", "minimum": 1},
        "turns": {"type": "integer", "minimum": 1},
        "context_tokens": {"type": "integer", "minimum": 1},
        "total_tokens": {"type": "integer", "minimum": 1}
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "verifier_command": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "required_components": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "uniqueItems": true
        },
        "success_threshold": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      }
    },
    "metadata": {
      "type": "object",
      "required": [
        "dataset_version",
        "starting_repository",
        "score_components",
        "draft",
        "synthetic"
      ],
      "properties": {
        "dataset_version": {"type": "string", "minLength": 1},
        "starting_repository": {"type": "string", "minLength": 1},
        "score_components": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "draft": {"type": "boolean"},
        "synthetic": {"type": "boolean"}
      }
    }
  }
}
